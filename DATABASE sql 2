-- ──────────────────────────────────────────
-- 1. USERS
-- ──────────────────────────────────────────
CREATE TABLE IF NOT EXISTS users (
  id            SERIAL PRIMARY KEY,
  full_name     TEXT NOT NULL,
  phone         TEXT UNIQUE NOT NULL,
  pin_hash      TEXT NOT NULL,
  balance       NUMERIC(12,2) NOT NULL DEFAULT 0.00,
  account_no    TEXT UNIQUE,
  avatar_url    TEXT,
  is_active     BOOLEAN NOT NULL DEFAULT true,
  is_verified   BOOLEAN NOT NULL DEFAULT false,
  created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at    TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE OR REPLACE FUNCTION gen_account_no()
RETURNS TRIGGER AS $$
BEGIN
  NEW.account_no = 'DAL' || LPAD(NEW.id::TEXT, 8, '0');
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS trg_account_no ON users;
CREATE TRIGGER trg_account_no
  BEFORE INSERT ON users
  FOR EACH ROW EXECUTE FUNCTION gen_account_no();

CREATE OR REPLACE FUNCTION touch_updated_at()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS trg_users_updated ON users;
CREATE TRIGGER trg_users_updated
  BEFORE UPDATE ON users
  FOR EACH ROW EXECUTE FUNCTION touch_updated_at();

-- ──────────────────────────────────────────
-- 2. OTP CODES
-- ──────────────────────────────────────────
CREATE TABLE IF NOT EXISTS otp_codes (
  id          SERIAL PRIMARY KEY,
  phone       TEXT NOT NULL,
  code        TEXT NOT NULL,
  purpose     TEXT NOT NULL DEFAULT 'register',
  expires_at  TIMESTAMPTZ NOT NULL,
  used        BOOLEAN NOT NULL DEFAULT false,
  created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_otp_phone ON otp_codes(phone);

-- ──────────────────────────────────────────
-- 3. TRANSACTIONS
-- ──────────────────────────────────────────
CREATE TABLE IF NOT EXISTS transactions (
  id            SERIAL PRIMARY KEY,
  sender_id     INT REFERENCES users(id),
  recipient_id  INT REFERENCES users(id),
  amount        NUMERIC(12,2) NOT NULL CHECK (amount > 0),
  type          TEXT NOT NULL DEFAULT 'transfer',
  status        TEXT NOT NULL DEFAULT 'completed',
  note          TEXT DEFAULT '',
  reference     TEXT UNIQUE DEFAULT gen_random_uuid()::TEXT,
  fee           NUMERIC(10,2) NOT NULL DEFAULT 0.00,
  created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_tx_sender    ON transactions(sender_id);
CREATE INDEX IF NOT EXISTS idx_tx_recipient ON transactions(recipient_id);
CREATE INDEX IF NOT EXISTS idx_tx_created   ON transactions(created_at DESC);
CREATE INDEX IF NOT EXISTS idx_tx_reference ON transactions(reference);

-- ──────────────────────────────────────────
-- 4. NOTIFICATIONS
-- ──────────────────────────────────────────
CREATE TABLE IF NOT EXISTS notifications (
  id              SERIAL PRIMARY KEY,
  user_id         INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  transaction_id  INT REFERENCES transactions(id) ON DELETE SET NULL,
  title           TEXT NOT NULL,
  message         TEXT NOT NULL,
  type            TEXT NOT NULL DEFAULT 'transfer',
  is_read         BOOLEAN NOT NULL DEFAULT false,
  created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_notif_user   ON notifications(user_id);
CREATE INDEX IF NOT EXISTS idx_notif_unread ON notifications(user_id) WHERE is_read = false;

-- ──────────────────────────────────────────
-- 5. CONTACTS
-- ──────────────────────────────────────────
CREATE TABLE IF NOT EXISTS contacts (
  id          SERIAL PRIMARY KEY,
  owner_id    INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  contact_id  INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  nickname    TEXT,
  created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  UNIQUE (owner_id, contact_id)
);

CREATE INDEX IF NOT EXISTS idx_contacts_owner ON contacts(owner_id);

